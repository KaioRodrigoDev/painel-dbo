# Copie este arquivo para .env.local na raiz do projeto.
# Este perfil habilita dashboard, contas, personagens, VIP e correio via banco.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte-com-pelo-menos-12-caracteres
SESSION_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
ADMIN_COOKIE_SECURE=true
MAX_CHARACTER_LEVEL=70

# Use 127.0.0.1 quando o MySQL estiver no mesmo Windows Server.
ACCOUNT_DB_HOST=127.0.0.1
ACCOUNT_DB_PORT=3306
ACCOUNT_DB_USER=dbow_admin
ACCOUNT_DB_PASSWORD=troque-esta-senha
ACCOUNT_DB_NAME=dbo_acc

CHARACTER_DB_HOST=127.0.0.1
CHARACTER_DB_PORT=3306
CHARACTER_DB_USER=dbow_admin
CHARACTER_DB_PASSWORD=troque-esta-senha
CHARACTER_DB_NAME=dbo_char

# As variaveis DBOW_GAME_ROOT, DBOW_EXECUTION_ENV e CLIENT_PACK_DIRECTORY
# podem ficar ausentes nesta primeira publicacao. As paginas que dependem de
# RDF, packs e executaveis do jogo nao funcionarao ate a proxima etapa.
