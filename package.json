{
  "name": "dbow-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/import-dbow-config.mjs",
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "vip:migrate": "node --env-file=.env.local --experimental-strip-types scripts/vip-job.mjs --migrate",
    "vip:expire": "node --env-file=.env.local --experimental-strip-types scripts/vip-job.mjs",
    "vip:dry-run": "node --env-file=.env.local --experimental-strip-types scripts/vip-job.mjs --dry-run",
    "vip:test": "node --experimental-strip-types --test scripts/vip-rules.test.mjs",
    "mail:migrate": "node --env-file=.env.local scripts/inspect-admin-mail.mjs --migrate",
    "mail:inspect": "node --env-file=.env.local scripts/inspect-admin-mail.mjs",
    "server:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-production.ps1",
    "server:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-production.ps1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "jose": "^6.2.9",
    "mysql2": "^3.23.4",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "typescript": "^5"
  }
}
