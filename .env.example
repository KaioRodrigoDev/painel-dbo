# Copie este arquivo para .env.local e preencha. O .env.local fica so na sua
# maquina -- nunca envie ele para ninguem, tem senha dentro.
#
# Passo a passo completo: leia INSTALACAO.md

# =============================================================================
# 1. ACESSO AO PAINEL
# =============================================================================

ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-com-pelo-menos-12-caracteres
SESSION_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Deixe false quando o painel roda em http://localhost. So ponha true se ele
# estiver atras de HTTPS -- com true em http o navegador descarta o cookie e o
# login fica em loop.
ADMIN_COOKIE_SECURE=false

MAX_CHARACTER_LEVEL=70

# =============================================================================
# 2. ONDE ESTA O JOGO
# =============================================================================
#
# Na maioria das instalacoes basta esta linha. Aponte para a pasta que CONTEM
# DboServer/ e ClientRuntime_RealBase/ -- todo o resto e derivado dela.

DBOW_GAME_ROOT=C:\caminho\para\a\pasta\do\jogo

# Se o painel estiver dentro dessa mesma pasta, ao lado de DboServer/, pode
# apagar a linha acima: os caminhos relativos ja funcionam sozinhos.

# -----------------------------------------------------------------------------
# Ajustes pontuais (opcionais)
#
# So use se algum arquivo estiver fora do lugar padrao. Cada um vence o
# DBOW_GAME_ROOT para aquele arquivo especifico, sem afetar os demais.
# -----------------------------------------------------------------------------

# Pasta ExecutionEnv do servidor (.exe, configs e tabelas).
# Padrao: <DBOW_GAME_ROOT>\DboServer\ExecutionEnv
# DBOW_EXECUTION_ENV=C:\jogo\DboServer\ExecutionEnv

# Pasta pack do cliente (tbl.pak, gui.pak, tex.pak e as unidades de dados).
# Padrao: <DBOW_GAME_ROOT>\ClientRuntime_RealBase\pack
# CLIENT_PACK_DIRECTORY=C:\jogo\ClientRuntime_RealBase\pack

# Tabelas .rdf. Padrao para todas:
#   <ExecutionEnv>\resource\server_data\table\rdf\<arquivo>
# SKILL_TABLE_PATH=C:\jogo\...\rdf\Table_Skill_Data.rdf
# SKILL_TEXT_TABLE_PATH=C:\jogo\...\rdf\table_text_all_data.rdf
# ITEM_TABLE_PATH=C:\jogo\...\rdf\Table_Item_Data.rdf
# ITEM_TEXT_TABLE_PATH=C:\jogo\...\rdf\table_text_all_data.rdf
# MOB_TABLE_PATH=C:\jogo\...\rdf\Table_MOB_Data.rdf
# MOB_TEXT_TABLE_PATH=C:\jogo\...\rdf\table_text_all_data.rdf

# Mantida por compatibilidade: nome antigo de CLIENT_PACK_DIRECTORY, aponta para
# a mesma pasta pack.
# ITEM_ICON_PACK_DIRECTORY=C:\jogo\ClientRuntime_RealBase\pack

# Restringe as pastas que o operador pode escolher ao publicar no cliente.
# Separe por ";". Sem esta variavel, qualquer caminho absoluto que contenha
# tbl.pak e aceito.
# CLIENT_PACK_ALLOWED_ROOTS=C:\jogo\ClientRuntime_RealBase\pack

# =============================================================================
# 3. BANCOS DE DADOS
# =============================================================================
#
# Os mesmos dados que estao nos .ini dos servidores, em <ExecutionEnv>\config\,
# nas secoes [DATABASE_ACCOUNT] e [DATABASE_CHARACTER].

ACCOUNT_DB_HOST=127.0.0.1
ACCOUNT_DB_PORT=3306
ACCOUNT_DB_USER=root
ACCOUNT_DB_PASSWORD=
ACCOUNT_DB_NAME=dbo_acc

CHARACTER_DB_HOST=127.0.0.1
CHARACTER_DB_PORT=3306
CHARACTER_DB_USER=root
CHARACTER_DB_PASSWORD=
CHARACTER_DB_NAME=dbo_char
